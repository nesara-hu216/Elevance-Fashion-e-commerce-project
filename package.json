{
  "name": "elevance-ecommerce-app",
  "version": "1.0.0",
  "description": "Complete production-hardened E-Commerce Application with Expo and Express.js",
  "main": "server/src/server.js",
  "scripts": {
    "postinstall": "cd client && npm install --production=false",
    "build": "node -e \"const fs=require('fs'),{execSync}=require('child_process');const dir=fs.existsSync('client')?'client':fs.existsSync('../client')?'../client':'.';if(!fs.existsSync(dir+'/node_modules/@expo/webpack-config')){execSync('npm install --production=false',{cwd:dir,stdio:'inherit'});}execSync('npm run build',{cwd:dir,stdio:'inherit'});\"",
    "start:server": "node server/src/server.js",
    "dev:server": "node --watch server/src/server.js",
    "seed": "node server/src/utils/seed.js",
    "test:server": "node --test server/tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
