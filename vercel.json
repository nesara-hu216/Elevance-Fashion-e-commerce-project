{
  "version": 2,
  "installCommand": "npm install && cd client && npm install --production=false",
  "buildCommand": "node -e \"const fs=require('fs'),{execSync}=require('child_process');const dir=fs.existsSync('client')?'client':fs.existsSync('../client')?'../client':'.';if(!fs.existsSync(dir+'/node_modules/@expo/webpack-config')){execSync('npm install --production=false',{cwd:dir,stdio:'inherit'});}execSync('npm run build',{cwd:dir,stdio:'inherit'});\"",
  "outputDirectory": "client/web-build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
