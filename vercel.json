{
  "version": 2,
  "buildCommand": "node -e \"const fs=require('fs'),{execSync}=require('child_process');const dir=fs.existsSync('client')?'client':fs.existsSync('../client')?'../client':'.';execSync('npm run build',{cwd:dir,stdio:'inherit'});\"",
  "outputDirectory": "client/web-build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
